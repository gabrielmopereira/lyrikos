# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/lyrikos

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Better Auth
BETTER_AUTH_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
BETTER_AUTH_URL=https://lyrikos.api.localhost

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://lyrikos.web.localhost

# Trusted Origins for Better Auth
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,https://lyrikos.web.localhost

# Optional: Resend API for email
RESEND_API_KEY=
FROM_EMAIL=noreply@lyrikos.example.com
